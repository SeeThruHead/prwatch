{
  "name": "prwatch",
  "version": "0.3.0",
  "description": "Watch your pull requests and hand new reviews, comments and CI results to the coding agent already working on that branch.",
  "license": "MIT",
  "bin": {
    "prwatch": "bin/prwatch.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "prwatch": "node --no-warnings bin/prwatch.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/node": "^24.0.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "rust-just": "1.59.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
