{
  "name": "prwatch",
  "version": "0.4.4",
  "description": "Watch your pull requests and hand new reviews, comments and CI results to the coding agent already working on that branch.",
  "license": "MIT",
  "bin": {
    "prwatch": "bin/prwatch.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "prwatch": "node --no-warnings bin/prwatch.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "patch": "effect-tsgo patch --oxlint",
    "unpatch": "effect-tsgo unpatch --oxlint",
    "setup": "pnpm run patch && lefthook install",
    "prepare": "pnpm run setup"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.64.1",
    "@effect/vitest": "4.1.2",
    "@types/node": "^24.0.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rust-just": "1.59.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
